# ── অবশ্যই লাগবে ────────────────────────────────────────
# সাইটের আসল ঠিকানা
NEXT_PUBLIC_SITE_URL=https://ghorowa.com

# Supabase → Project Settings → Database → Connection string → "Transaction pooler" (পোর্ট 6543)
DATABASE_URL=postgresql://postgres.xxxx:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Supabase → Project Settings → API Keys → Secret key (sb_secret_…) অথবা Legacy ট্যাবের service_role কী — গোপন রাখুন
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# লগইন সুরক্ষার জন্য অন্তত ৩২ অক্ষরের এলোমেলো লেখা (https://generate-secret.vercel.app/32)
AUTH_SECRET=

# অ্যাডমিন প্যানেলে (/admin) লগইনের ইমেইল ও পাসওয়ার্ড
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=

# ── ঐচ্ছিক ──────────────────────────────────────────────
# বিকাশ অনলাইন পেমেন্ট (মার্চেন্ট অ্যাকাউন্ট লাগবে)
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=

# Steadfast কুরিয়ার (Steadfast প্যানেল → API)
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=

# নতুন অর্ডারের নোটিফিকেশন
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ORDER_WEBHOOK_URL=
